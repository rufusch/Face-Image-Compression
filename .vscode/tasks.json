{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FaceLab",
      "type": "shell",
      "command": ".\\start.bat",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Test FaceLab",
      "type": "shell",
      "command": "python",
      "args": ["-m", "unittest", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
